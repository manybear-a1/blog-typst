      {
       "data": "<div class=\"wexpr\"><wgraph class=\"resizable\" style=\"width:892px;height:25px;\" aspect-ratio=\"0.0278\" tabIndex=\"-1\"><img class=\"invert-brightness\" src=\"data:image/png;base64,\" /></wgraph></div>",
